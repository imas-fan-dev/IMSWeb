# Generated by Cargo
# will have compiled files and executables
/target/

# Platform projects produced by `tauri ios init` / `tauri android init`.
# They are derived from tauri.conf.json, Cargo.toml and the CLI version, and
# ship with trailing whitespace that trips the staged-whitespace gate. Build
# scripts reapply conditional Android manifest values after generation; keep
# those decisions in tracked scripts instead of checking in this directory.
/gen/
