<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Device builds can load development resources or call a controlled private
	  LAN backend over HTTP. ATS exempts localhost but not private addresses,
	  so the Simulator works while a real device does not.
	  NSAllowsLocalNetworking relaxes cleartext only for private/link-local
	  addresses and .local names; public TLS requirements are untouched.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
	  iOS 14+ gates connections to local addresses behind an explicit consent
	  prompt. The key is surfaced only when the app reaches a local development
	  resource or private LAN backend.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>连接同一局域网内的 IMSWeb 服务，以加载数据和媒体。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>位置仅用于在事务所地图上显示您的当前位置并将地图移回该位置。</string>
	<!--
		iOS 27 requires apps built with the iOS 27 SDK to adopt the UIKit scene-based
		life cycle; without UIApplicationSceneManifest UIKit traps in
		UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption (SIGTRAP) before the
		webview is created.

		tao 0.35.3 only takes its scene code path when
		UIApplicationSceneManifest.UIApplicationSupportsMultipleScenes is true, and it then
		supplies the scene configuration at runtime through
		application(_:configurationForConnecting:options:), so UISceneConfigurations stays
		empty here. Drop this file once the Tauri CLI template enables the scene life cycle
		on its own (tauri-apps/tauri#15254).
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
</dict>
</plist>
