{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IMSWeb",
  "version": "0.1.0",
  "identifier": "top.idol-master.imsweb",
  "build": {
    "frontendDist": "../build-app/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev:app",
    "beforeBuildCommand": "pnpm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "IMSWeb",
        "width": 420,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
