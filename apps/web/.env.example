# This file is a shell template; Web tooling does not expose these values to
# browser code. Export them before running the corresponding command.

# React Router development proxy target for same-origin API and media routes.
IMS_API_ORIGIN=http://127.0.0.1:3000

# Server-only proxy target for legacy /brand/about/** media. This is not exposed
# to browser code and must not point back to the current Vite development URL.
IMS_PUBLIC_SITE_ORIGIN=https://idol-master.top

# Optional URL of an already-running Web server for Playwright.
E2E_BASE_URL=http://127.0.0.1:4173

# Absolute API origin for builds whose frontend is not served by the API.
# Unlike the variables above, Vite inlines this one into browser code, so treat
# it as public and never put a secret here. Leave it unset for browser builds so
# requests stay same-origin. `build:app` defaults to https://idol-master.top and
# validates an explicit override; `dev:app` clears this variable so Tauri's
# same-origin dev URL forwards API requests through the local Vite proxy.
# VITE_IMS_API_ORIGIN=https://idol-master.top

# Explicit acknowledgement for a signed App build that uses a private HTTP API
# instead of HTTPS. `build:app` accepts only RFC1918 IPv4 origins under this
# opt-in; it never permits public HTTP API origins.
# IMS_ALLOW_INSECURE_LAN_APP_ORIGIN=1

# Absolute public address of the website, used for links a person copies and
# opens in a browser later. Vite inlines it into browser code just like
# VITE_IMS_API_ORIGIN, so treat it as public and never put a secret here. Leave
# it unset for browser builds so links resolve against the document. App builds
# set the production value; App development uses the validated local 1420/LAN
# origin while API requests remain same-origin through Tauri's dev URL.
# VITE_IMS_PUBLIC_SITE_ORIGIN=https://idol-master.top

# Optional HTTP(S) host for MapLibre styles, PMTiles, fonts, and sprites in a
# packaged App. It does not change API requests or external website links. A
# private HTTP host requires IMS_ALLOW_INSECURE_LAN_APP_ORIGIN=1.
# VITE_IMS_MAP_TRANSPORT_ORIGIN=http://192.168.31.169:1420

# Build-time target switch. Like VITE_IMS_API_ORIGIN, Vite inlines this into
# browser code, so treat it as public. "app" excludes admin routes from the
# route manifest to produce the Tauri-packaged build; leave it unset for the
# web build so the route manifest stays unchanged.
# VITE_IMS_APP_TARGET=app
