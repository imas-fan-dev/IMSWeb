# This file is a template only; the API does not load it automatically.
# Export values in the shell or inject them with the process supervisor.
# Never commit a populated .env file or a real secret.
NODE_ENV=production
IMS_JWT_SECRET=
IMS_COOKIE_SECURE=true

# Hono Node binds to loopback behind Nginx in production.
HOST=127.0.0.1
PORT=3000

# Mutable media storage. The AWS SDK uses its standard credential provider
# chain; prefer an instance/task role over long-lived access keys.
IMS_OBJECT_STORAGE=filesystem
IMS_S3_BUCKET=
IMS_S3_REGION=
IMS_S3_ENDPOINT=
IMS_S3_FORCE_PATH_STYLE=false
IMS_S3_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Local MinIO started by `pnpm run dev:minio:up`:
# IMS_OBJECT_STORAGE=s3
# IMS_S3_BUCKET=imsweb-test
# IMS_S3_REGION=us-east-1
# IMS_S3_ENDPOINT=http://127.0.0.1:9000
# IMS_S3_FORCE_PATH_STYLE=true
# IMS_S3_PREFIX=local
# AWS_ACCESS_KEY_ID=imsweb-local
# AWS_SECRET_ACCESS_KEY=imsweb-local-password

# These local compatibility paths assume IMS_PROJECT_ROOT is the repository
# root. Production must use absolute paths under /srv/ims/shared and point
# IMS_PUBLIC_DIR at the active release's apps/api/dist/node-client directory.
IMS_DB_PATH=./apps/legacy/data/core/news.db
IMS_COMPENSATION_DIR=./apps/legacy/data/core/compensation
IMS_IDEMPOTENCY_DIR=./apps/legacy/data/core/idempotency
IMS_PUBLIC_DIR=./apps/legacy/public
IMS_UPLOADS_DIR=./apps/legacy/data/uploads
IMS_EVENT_BASE_DIR=./apps/legacy/data/chronicle
IMS_STORY_DB_PATH=./apps/legacy/data/story/idol_data.db
IMS_STORY_DATA_DIR=./apps/legacy/data/story/images
IMS_STORY_MAX_UPLOAD_BYTES=52428800

# One-shot account administration. Leave passwords unset except in the shell
# that executes the corresponding apps/api operation command.
IMS_NEW_USER_USERNAME=
IMS_NEW_USER_PASSWORD=
IMS_NEW_USER_DEPT=editor
IMS_NEW_USER_PRODUCER_NAME=
IMS_PASSWORD_TO_HASH=
