{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/server/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/server/worker.ts",
    "src/server/app.ts",
    "src/server/ports/**/*.ts",
    "src/server/adapters/cloudflare/**/*.ts",
    "src/server/adapters/shared/**/*.ts",
    "src/server/middleware/hono-auth.ts",
    "src/server/shared/hono-utils.ts",
    "src/server/shared/static-path-policy.ts",
    "src/server/shared/stored-object-response.ts",
    "src/server/domains/**/*hono*.ts",
    "src/server/domains/wiki/**/*.ts",
    "src/server/domains/wiki/**/*.tsx"
  ]
}
