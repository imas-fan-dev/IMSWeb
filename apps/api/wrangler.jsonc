{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imsweb-hono",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/wiki/*",
      "/story*",
      "/image/*",
      "/uploads/*",
      "/eventchronicle/*",
      "/assets/images/eventchronicle/events/*",
      "/runninggame/Build/*.data",
      "/runninggame/BuildMobile/*.data",
      "/Data/*",
      "/templates/*",
      "/*.db*",
      "/*.py",
      "/*.ini"
    ]
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "ims-core-placeholder",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "STORY_DB",
      "database_name": "ims-story-placeholder",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations/story"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ims-media-placeholder"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
