# Docker Compose environment for deploy/compose.yaml.
# Use with docker compose --env-file deploy/.env ...
IMS_NGINX_IMAGE=nginx:1.30.4-alpine3.24
IMS_NGINX_LISTEN_PORT=8080
IMS_NGINX_SERVER_NAME=_
IMS_SITE_PACKAGE_SERVER_NAME=ims-content.example.net
# Enable only when this listener is reachable exclusively through a trusted
# outer proxy that overwrites X-Forwarded-Proto and X-Forwarded-Port.
IMS_TRUST_OUTER_PROXY=false
IMS_NODE_UPSTREAM=127.0.0.1:3000
IMS_CLIENT_MAX_BODY_SIZE=50m

# Current stack PostgreSQL. Production credentials must come from a secret manager.
IMS_POSTGRES_IMAGE=postgres:18.4-alpine
IMS_POSTGRES_PORT=5432
IMS_POSTGRES_DB=imsweb
IMS_POSTGRES_USER=imsweb
IMS_POSTGRES_PASSWORD=imsweb-local-password

# Current stack local S3-compatible object storage.
IMS_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
IMS_MINIO_API_PORT=9000
IMS_MINIO_CONSOLE_PORT=9001
IMS_MINIO_ROOT_USER=imsweb-local
IMS_MINIO_ROOT_PASSWORD=imsweb-local-password
IMS_MINIO_BUCKET=imsweb-test
