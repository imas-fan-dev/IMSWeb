# Docker Compose environment for deploy/compose.yaml.
# Use with docker compose --env-file deploy/.env ...
# The local-cache profile starts Valkey and local-storage starts RustFS. Leave
# local-storage out when the API uses an external S3-compatible service such as R2.
COMPOSE_PROFILES=local-cache,local-storage

# Local PostgreSQL. Production credentials must come from a secret manager.
IMS_POSTGRES_IMAGE=postgres:18.4-alpine
IMS_POSTGRES_PORT=5432
IMS_POSTGRES_DB=imsweb
IMS_POSTGRES_USER=imsweb
IMS_POSTGRES_PASSWORD=imsweb-local-password

# Local S3-compatible object storage.
IMS_RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.12
IMS_S3_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
IMS_RUSTFS_API_PORT=9000
IMS_RUSTFS_CONSOLE_PORT=9001
IMS_RUSTFS_ACCESS_KEY=imsweb-local
IMS_RUSTFS_SECRET_KEY=imsweb-local-password
IMS_RUSTFS_BUCKET=imsweb-media-local

# Ephemeral Valkey cache. Registration cooldowns never store email or codes here;
# PostgreSQL remains the verification source of truth.
IMS_VALKEY_IMAGE=valkey/valkey:8.1.9-alpine
IMS_VALKEY_PORT=6379
IMS_VALKEY_MAX_MEMORY=128mb
IMS_CACHE_BACKEND=valkey
IMS_VALKEY_URL=redis://valkey:6379
IMS_VALKEY_KEY_PREFIX=imsweb:cache:
IMS_VALKEY_CONNECT_TIMEOUT_MS=5000

# API object storage. Keep these local values aligned with the RustFS settings
# above. Production R2 uses region auto, its S3 API endpoint, and a custom-domain
# public read base; IMS_S3_PREFIX may be intentionally empty.
IMS_OBJECT_STORAGE=s3
IMS_S3_BUCKET=imsweb-media-local
IMS_PUBLIC_READ_URL_BASE=http://127.0.0.1:9000/imsweb-media-local
IMS_S3_REGION=us-east-1
IMS_S3_ENDPOINT=http://rustfs:9000
IMS_S3_FORCE_PATH_STYLE=true
IMS_S3_PREFIX=
IMS_S3_READ_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=imsweb-local
AWS_SECRET_ACCESS_KEY=imsweb-local-password

# Local Hono API image and host binding. The Compose API runs the PostgreSQL
# migrations before it starts. Keep the database URL aligned with the database
# credentials above; URL-encode reserved characters in its password component.
IMS_API_IMAGE=imsweb-api:local
# Build dependency mirrors. Override the Debian mirror for the current network;
# Corepack, pnpm and native Node headers use the npm mirrors below.
IMS_DEBIAN_MIRROR_BASE=http://mirrors.tuna.tsinghua.edu.cn
IMS_NPM_REGISTRY=https://registry.npmmirror.com
IMS_NODE_HEADERS_MIRROR=https://npmmirror.com/mirrors/node
IMS_API_PORT=3000
IMS_API_NODE_ENV=development
IMS_API_DATABASE_URL=postgresql://imsweb:imsweb-local-password@postgres:5432/imsweb
IMS_BACKOFFICE_JWT_SECRET=imsweb-local-development-secret-change-before-sharing
# Previous-release Backoffice JWT verification only. Leave empty for a fresh install.
IMS_JWT_SECRET=
# Independent Platform realm; do not reuse either Backoffice secret.
IMS_PLATFORM_JWT_SECRET=imsweb-local-development-platform-secret-change-before-sharing
# Development prints Platform registration codes to the API console. Production
# rejects console and must use cloudflare with the account, token, and sender set.
IMS_PLATFORM_EMAIL_DELIVERY=console
IMS_CLOUDFLARE_EMAIL_ACCOUNT_ID=
IMS_CLOUDFLARE_EMAIL_API_TOKEN=
IMS_PLATFORM_EMAIL_FROM=
IMS_PLATFORM_EMAIL_FROM_NAME=IMSWeb
# OAuth provider request timeout. Provider credentials and redirect URIs are
# configured by a super administrator at /admin/platform/oauth; client secrets
# are encrypted in PostgreSQL and never returned to the browser.
IMS_PLATFORM_OAUTH_REQUEST_TIMEOUT_MS=10000
IMS_COOKIE_SECURE=false
# On the first role-enabled production startup, set an existing op username.
IMS_SUPER_ADMIN_USERNAME=
IMS_CLIENT_ADDRESS_SOURCE=direct
IMS_FUDABA_PUBLIC_READ_ENABLED=false
# Independent authenticated profile/card mutation rollout gate.
IMS_FUDABA_WRITE_ENABLED=false
# Independent privacy-reviewed map rollout gate. The bundled style and province
# GeoJSON are served from the application origin and make no third-party requests.
IMS_FUDABA_MAP_ENABLED=false
IMS_FUDABA_MAP_STYLE_URL=/maps/exchange-style.json
# Authenticated Nominatim-compatible place search proxy. Keep empty to disable.
IMS_FUDABA_GEOCODING_ENDPOINT=
IMS_FUDABA_GEOCODING_USER_AGENT=
IMS_FUDABA_GEOCODING_COUNTRY_CODES=cn
IMS_PG_POOL_MAX=10
IMS_PG_IDLE_TIMEOUT_MS=30000
IMS_PG_CONNECTION_TIMEOUT_MS=5000
IMS_PG_STATEMENT_TIMEOUT_MS=30000
IMS_PG_IDLE_TRANSACTION_TIMEOUT_MS=30000
