# Docker Compose environment for deploy/compose.yaml.
# Use with docker compose --env-file deploy/.env ...
# Local PostgreSQL. Production credentials must come from a secret manager.
IMS_POSTGRES_IMAGE=postgres:18.4-alpine
IMS_POSTGRES_PORT=5432
IMS_POSTGRES_DB=imsweb
IMS_POSTGRES_USER=imsweb
IMS_POSTGRES_PASSWORD=imsweb-local-password

# Local S3-compatible object storage.
IMS_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
IMS_MINIO_API_PORT=9000
IMS_MINIO_CONSOLE_PORT=9001
IMS_MINIO_ROOT_USER=imsweb-local
IMS_MINIO_ROOT_PASSWORD=imsweb-local-password
IMS_MINIO_BUCKET=imsweb-media-local

# Local Hono API image and host binding. The Compose API runs the PostgreSQL
# migrations before it starts. Keep the database URL aligned with the database
# credentials above; URL-encode reserved characters in its password component.
IMS_API_IMAGE=imsweb-api:local
IMS_API_PORT=3000
IMS_API_NODE_ENV=development
IMS_API_DATABASE_URL=postgresql://imsweb:imsweb-local-password@postgres:5432/imsweb
IMS_JWT_SECRET=imsweb-local-development-secret-change-before-sharing
IMS_COOKIE_SECURE=false
IMS_CLIENT_ADDRESS_SOURCE=direct
IMS_SITE_ORIGIN=http://127.0.0.1:3000
IMS_S3_PREFIX=local
IMS_S3_READ_URL_TTL_SECONDS=300
