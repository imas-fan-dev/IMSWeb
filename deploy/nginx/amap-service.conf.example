# Optional: include inside the application's TLS server block.
# Replace both placeholders in a private copy outside the repository.
# For multiple JS API keys, use a server-side key -> security-code map instead.
location ^~ /_AMapService/v4/map/styles {
    limit_except GET { deny all; }
    if ($arg_key != "__AMAP_PUBLIC_JS_KEY__") { return 403; }
    if ($arg_jscode != "") { return 403; }
    set $args "$args&jscode=__AMAP_SECURITY_JS_CODE__";
    proxy_ssl_server_name on;
    proxy_set_header Host webapi.amap.com;
    proxy_pass https://webapi.amap.com/v4/map/styles;
    add_header Access-Control-Allow-Origin "*" always;
}

location ^~ /_AMapService/ {
    limit_except GET { deny all; }
    if ($arg_key != "__AMAP_PUBLIC_JS_KEY__") { return 403; }
    if ($arg_jscode != "") { return 403; }
    set $args "$args&jscode=__AMAP_SECURITY_JS_CODE__";
    proxy_ssl_server_name on;
    proxy_set_header Host restapi.amap.com;
    proxy_pass https://restapi.amap.com/;
    add_header Access-Control-Allow-Origin "*" always;
}
