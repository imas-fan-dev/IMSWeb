map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream ims_node {
    server ${IMS_NODE_UPSTREAM};
    keepalive 32;
}

server {
    listen ${IMS_NGINX_LISTEN_PORT} default_server;
    server_name ${IMS_NGINX_SERVER_NAME};
    server_tokens off;
    client_max_body_size ${IMS_CLIENT_MAX_BODY_SIZE};

    include /etc/nginx/snippets/ims-security.conf;
    include ${IMS_EMERGENCY_INCLUDE};

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location = /readyz {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node/api/wiki/test;
    }

    location /story {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node;
    }

    location /wiki/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node;
    }

    location /image/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node;
    }

    location /api/wiki/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node;
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_node;
    }
}
