# Host-installed Nginx ingress for IMSWeb and a same-host RustFS service.
# Replace __IMS_APP_DOMAIN__, __IMS_S3_DOMAIN__, and __IMS_CERT_NAME__ before use.

upstream imsweb_node {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream imsweb_rustfs {
    server 127.0.0.1:9000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __IMS_APP_DOMAIN__ __IMS_S3_DOMAIN__;

    return 301 https://$host$request_uri;
}

# The production Web build is served by Hono. Sending the complete hostname to
# one upstream keeps Web routes, /api, media routes, and auth cookies same-origin.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __IMS_APP_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__IMS_CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__IMS_CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:IMSWebSSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100m;

    location / {
        proxy_pass http://imsweb_node;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace, rather than append to, any client-supplied forwarding chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Use a separate hostname for RustFS even when it runs on the application host.
# S3 SigV4 covers the host and path, so both are forwarded without rewriting.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __IMS_S3_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__IMS_CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__IMS_CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:IMSWebSSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 100m;

    location / {
        proxy_pass http://imsweb_rustfs;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
