map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

map "${IMS_TRUST_OUTER_PROXY}:$http_x_forwarded_proto" $ims_forwarded_proto {
    default $scheme;
    ~*^true:https$ https;
    ~*^true:http$  http;
}

map "${IMS_TRUST_OUTER_PROXY}:$http_x_forwarded_proto:$http_x_forwarded_port" $ims_forwarded_port {
    default $server_port;
    ~*^true:https:$ 443;
    ~*^true:http:$  80;
    ~*^true:(?:https|http):([1-9][0-9]*)$ $1;
}

upstream ims_legacy_node {
    server ${IMS_LEGACY_NODE_UPSTREAM};
    keepalive 32;
}

upstream ims_legacy_flask {
    server ${IMS_LEGACY_FLASK_UPSTREAM};
    keepalive 16;
}

server {
    listen ${IMS_NGINX_LISTEN_PORT} default_server;
    server_name ${IMS_NGINX_SERVER_NAME};
    server_tokens off;
    client_max_body_size ${IMS_CLIENT_MAX_BODY_SIZE};

    include /etc/nginx/snippets/ims-security.conf;
    include /etc/nginx/snippets/ims-emergency-deny.conf;

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location = /readyz {
        access_log off;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_node/api/news;
    }

    location /story {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_flask;
    }

    location /wiki/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_flask/;
    }

    location /image/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_flask;
    }

    location /api/wiki/ {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_flask;
    }

    location / {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://ims_legacy_node;
    }
}
