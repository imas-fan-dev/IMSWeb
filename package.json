{
  "name": "imsweb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "IMSWeb monorepo workspace orchestrator",
  "scripts": {
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "check:root": "pnpm run check:boundaries && sh -n scripts/checks/legacy-readiness-check.sh && sh -n scripts/migration/legacy-inventory.sh && sh -n scripts/migration/activate-node-release.sh && node --check scripts/migration/preflight-node-release.cjs && sh -n scripts/operations/backups/backup-legacy-source.sh",
    "build:server": "pnpm --filter @imsweb/api run build:server",
    "build:client": "pnpm --filter @imsweb/api run build:client",
    "build:api": "pnpm --filter @imsweb/api run build",
    "build:web": "pnpm --filter @imsweb/web run build",
    "build": "pnpm run check:boundaries && pnpm run build:api && pnpm run build:web",
    "syntax": "pnpm --filter @imsweb/api run syntax",
    "typecheck:server": "pnpm --filter @imsweb/api run typecheck:server",
    "check:assets": "pnpm --filter @imsweb/api run check:assets",
    "check:api": "pnpm --filter @imsweb/api run check",
    "check:web": "pnpm --filter @imsweb/web run check",
    "check": "pnpm run check:root && pnpm run check:api && pnpm run check:web",
    "test:api": "pnpm --filter @imsweb/api run test",
    "test:web": "pnpm --filter @imsweb/web run test",
    "test:web:unit": "pnpm --filter @imsweb/web run test:unit",
    "test:web-routing": "pnpm run build:web && pnpm run build:server && pnpm --filter @imsweb/api run test:web-routing",
    "test:infra": "python3 -m unittest tests/test_legacy_data_audit.py tests/test_release_activation.py tests/test_operations_docs.py tests/test_nginx_deployment.py tests/test_workspace_boundaries.py tests/test_legacy_source_backup.py",
    "test": "pnpm run check:root && pnpm run test:infra && pnpm run test:api && pnpm run test:web:unit && pnpm run test:web-routing",
    "test:fast": "pnpm run test",
    "start": "pnpm --filter @imsweb/api run start",
    "start:node": "pnpm --filter @imsweb/api run start:node",
    "dev:node": "pnpm --filter @imsweb/api run dev:node",
    "dev:web": "pnpm --filter @imsweb/web run dev",
    "dev:minio:config": "docker compose -f deploy/compose.yaml config",
    "dev:minio:up": "docker compose -f deploy/compose.yaml up -d minio minio-init",
    "dev:minio:logs": "docker compose -f deploy/compose.yaml logs -f minio",
    "dev:minio:down": "docker compose -f deploy/compose.yaml stop minio",
    "dev:postgresql:config": "docker compose -f deploy/compose.yaml config",
    "dev:postgresql:up": "docker compose -f deploy/compose.yaml up -d postgres",
    "dev:postgresql:logs": "docker compose -f deploy/compose.yaml logs -f postgres",
    "dev:postgresql:down": "docker compose -f deploy/compose.yaml stop postgres",
    "preview:web": "pnpm --filter @imsweb/web run preview",
    "check:readiness": "sh scripts/checks/legacy-readiness-check.sh",
    "audit:data": "python3 scripts/audit/legacy-data-audit.py",
    "migration:inventory": "sh scripts/migration/legacy-inventory.sh",
    "migration:sqlite:merge": "pnpm --filter @imsweb/api run migration:sqlite:merge",
    "migration:postgresql": "pnpm --filter @imsweb/api run migration:postgresql",
    "migration:postgresql:import-sqlite": "pnpm --filter @imsweb/api run migration:postgresql:import-sqlite",
    "media:information:sync": "pnpm --filter @imsweb/api run migration:information-media",
    "media:uploads:sync": "pnpm --filter @imsweb/api run migration:upload-media",
    "migration:release:activate": "sh scripts/migration/activate-node-release.sh",
    "migration:release:rollback": "sh scripts/migration/activate-node-release.sh --rollback",
    "wiki:media:sync": "pnpm --filter @imsweb/api run migration:wiki-media",
    "ops:account:add": "pnpm --filter @imsweb/api run ops:account:add",
    "ops:password:hash": "pnpm --filter @imsweb/api run ops:password:hash",
    "user:add": "pnpm run ops:account:add",
    "password:hash": "pnpm run ops:password:hash",
    "ops:nginx:config": "docker compose -f deploy/compose.yaml config",
    "ops:nginx:test": "docker compose -f deploy/compose.yaml run --rm --no-deps nginx nginx -t",
    "ops:nginx:up": "docker compose -f deploy/compose.yaml up -d nginx",
    "ops:nginx:reload": "docker compose -f deploy/compose.yaml exec nginx nginx -t && docker compose -f deploy/compose.yaml exec nginx nginx -s reload",
    "ops:nginx:logs": "docker compose -f deploy/compose.yaml logs -f nginx",
    "ops:nginx:down": "docker compose -f deploy/compose.yaml stop nginx",
    "ops:legacy:config": "docker compose -f deploy/compose.legacy.yaml config",
    "ops:legacy:test": "docker compose -f deploy/compose.legacy.yaml run --rm --no-deps nginx nginx -t",
    "ops:legacy:up": "docker compose -f deploy/compose.legacy.yaml up -d nginx",
    "ops:legacy:reload": "docker compose -f deploy/compose.legacy.yaml exec nginx nginx -t && docker compose -f deploy/compose.legacy.yaml exec nginx nginx -s reload",
    "ops:legacy:logs": "docker compose -f deploy/compose.legacy.yaml logs -f nginx",
    "ops:legacy:down": "docker compose -f deploy/compose.legacy.yaml down",
    "legacy:build": "pnpm --filter @imsweb/legacy run build",
    "legacy:python:sync": "pnpm --filter @imsweb/legacy run python:sync",
    "legacy:check": "pnpm --filter @imsweb/legacy run check",
    "legacy:test": "pnpm --filter @imsweb/legacy run test",
    "legacy:start:node": "pnpm --filter @imsweb/legacy run start:node",
    "legacy:start:flask": "pnpm --filter @imsweb/legacy run start:flask",
    "legacy:backup:source": "sh scripts/operations/backups/backup-legacy-source.sh",
    "test:all": "pnpm run test && pnpm run legacy:test"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
