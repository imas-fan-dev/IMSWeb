{
  "name": "imsweb-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "IMSWeb monorepo workspace orchestrator",
  "license": "MIT",
  "scripts": {
    "check:rules": "node scripts/check-agent-rules.mjs",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "design:lint": "pnpm --filter @imsweb/web run design:lint",
    "check:root": "pnpm run check:rules && pnpm run check:boundaries && pnpm run design:lint && sh -n scripts/migration/activate-node-release.sh && node --check scripts/migration/preflight-node-release.cjs",
    "build:server": "pnpm --filter @imsweb/api run build:server",
    "build:client": "pnpm --filter @imsweb/api run build:client",
    "build:api": "pnpm --filter @imsweb/api run build",
    "build:web": "pnpm --filter @imsweb/web run build",
    "build": "pnpm run check:boundaries && pnpm run build:web && pnpm run build:api && pnpm run build:client",
    "syntax": "pnpm --filter @imsweb/api run syntax",
    "typecheck:server": "pnpm --filter @imsweb/api run typecheck:server",
    "check:assets": "pnpm --filter @imsweb/api run check:assets",
    "check:api": "pnpm --filter @imsweb/api run check",
    "check:web": "pnpm --filter @imsweb/web run check",
    "check": "pnpm run check:root && pnpm run check:web && pnpm run check:api && pnpm run check:assets",
    "test:api": "pnpm --filter @imsweb/api run test",
    "test:web": "pnpm --filter @imsweb/web run test",
    "test:web:unit": "pnpm --filter @imsweb/web run test:unit",
    "test:web-routing": "pnpm run build:web && pnpm run build:server && pnpm --filter @imsweb/api run test:web-routing",
    "test:infra": "python3 -m unittest tests/test_agent_rules.py tests/test_release_activation.py tests/test_operations_docs.py tests/test_compose_deployment.py tests/test_workspace_boundaries.py",
    "test": "pnpm run check:root && pnpm run test:infra && pnpm run test:api && pnpm run test:web:unit && pnpm run test:web-routing",
    "test:fast": "pnpm run test",
    "start": "pnpm --filter @imsweb/api run start",
    "start:node": "pnpm --filter @imsweb/api run start:node",
    "dev:node": "pnpm --filter @imsweb/api run dev:node",
    "dev:web": "pnpm --filter @imsweb/web run dev",
    "dev:data:export": "pnpm --filter @imsweb/api run dev:data:export",
    "dev:data:restore": "pnpm --filter @imsweb/api run dev:data:restore",
    "dev:minio:config": "docker compose --profile local-storage -f deploy/compose.yaml config",
    "dev:minio:up": "docker compose --profile local-storage -f deploy/compose.yaml up -d minio minio-init",
    "dev:minio:logs": "docker compose --profile local-storage -f deploy/compose.yaml logs -f minio",
    "dev:minio:down": "docker compose --profile local-storage -f deploy/compose.yaml stop minio",
    "dev:postgresql:config": "docker compose -f deploy/compose.yaml config",
    "dev:postgresql:up": "docker compose -f deploy/compose.yaml up -d postgres",
    "dev:postgresql:logs": "docker compose -f deploy/compose.yaml logs -f postgres",
    "dev:postgresql:down": "docker compose -f deploy/compose.yaml stop postgres",
    "dev:api:config": "docker compose --profile local-storage -f deploy/compose.yaml config",
    "dev:api:up": "docker compose --profile local-storage -f deploy/compose.yaml up -d --build api",
    "dev:api:logs": "docker compose --profile local-storage -f deploy/compose.yaml logs -f api",
    "dev:api:down": "docker compose --profile local-storage -f deploy/compose.yaml stop api",
    "preview:web": "pnpm --filter @imsweb/web run preview",
    "migration:sqlite:merge": "pnpm --filter @imsweb/api run migration:sqlite:merge",
    "migration:postgresql": "pnpm --filter @imsweb/api run migration:postgresql",
    "migration:postgresql:import-sqlite": "pnpm --filter @imsweb/api run migration:postgresql:import-sqlite",
    "migration:object-keys": "pnpm --filter @imsweb/api run migration:object-keys",
    "media:information:sync": "pnpm --filter @imsweb/api run migration:information-media",
    "media:namecards:sync": "pnpm --filter @imsweb/api run migration:namecards",
    "media:producer-map:sync": "pnpm --filter @imsweb/api run migration:producer-map",
    "media:uploads:sync": "pnpm --filter @imsweb/api run migration:upload-media",
    "migration:public-objects": "pnpm --filter @imsweb/api run migration:public-objects",
    "migration:single-bucket": "pnpm --filter @imsweb/api run migration:single-bucket",
    "migration:release:activate": "sh scripts/migration/activate-node-release.sh",
    "migration:release:rollback": "sh scripts/migration/activate-node-release.sh --rollback",
    "wiki:media:sync": "pnpm --filter @imsweb/api run migration:wiki-media",
    "wiki:metadata:audit": "pnpm --filter @imsweb/api run wiki:metadata:audit",
    "ops:account:add": "pnpm --filter @imsweb/api run ops:account:add",
    "ops:password:hash": "pnpm --filter @imsweb/api run ops:password:hash",
    "user:add": "pnpm run ops:account:add",
    "password:hash": "pnpm run ops:password:hash",
    "test:all": "pnpm run test"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
