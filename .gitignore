# JavaScript dependencies and tooling caches
node_modules/
.pnpm-store/
.npm/
coverage/
dist/
.wrangler/

# Local environment and secrets
.env
.env.*
!.env.example
.secrets/
secrets/
*.secret
*.key
*.pem
*.p12

# Runtime state
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.log
*.pid
*.sock
logs/
**/database/compensation/

# Local exports and backup archives
.backups/
*.bak
*.old
*.orig
*.tar
*.tar.gz
*.tgz
*.zip
*.7z

# Python environments and caches
.venv/
venv/
*_venv/
**/venv/
**/*_venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Mutable application data (back up and migrate outside Git)
data/**
!data/.gitignore
apps/*/data/
**/public/uploads/
**/public/Data/
**/public/assets/images/eventchronicle/events/upload/
**/public/assets/images/eventchronicle/events/used/
**/public/assets/images/eventchronicle/events/meta/
**/public/assets/images/eventchronicle/events/.idempotency/
**/public/assets/images/eventchronicle/events/.staging/
**/public/assets/images/eventchronicle/events/.trash/

# Local git worktrees managed by scripts/development/worktree.mjs
.worktrees/

# Personal notes and planning (local only)
note/

# Process and editor artefacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Trellis-generated local tooling
# Regenerate integration files in a fresh clone with: trellis init --pi
.trellis/*
!.trellis/tasks/
!.trellis/spec/
!.trellis/workspace/
!.trellis/.gitignore
.agents/
.pi/
